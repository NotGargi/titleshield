# Copy to .env. Every value has a working default, so .env is optional on a Mac with Postgres.app.

# ---------- Core ----------
# No user or password needed with Postgres.app / Homebrew (it logs in as your Mac user).
# Example with a user: postgres://gargiverma@localhost:5432/titleshield
DATABASE_URL=postgres://localhost:5432/titleshield
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string-32+
# 64 hex chars (32 bytes); required in production
FIELD_ENCRYPTION_KEY=

# ---------- TinyFish (free tier only: Search + Fetch) ----------
# Free key, no card: https://agent.tinyfish.ai/api-keys
# Easier: leave this blank and paste the key on the app's Settings page.
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai/
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai/
# Published free-tier limits. The app waits rather than exceed them.
TINYFISH_SEARCH_PER_MIN=30
TINYFISH_SEARCH_PER_HOUR=500
TINYFISH_FETCH_PER_MIN=150
TINYFISH_FETCH_PER_DAY=1000
# Search and page results are reused for this long, to save free quota
WEB_CACHE_HOURS=12
# Pages each web agent reads per search
PAGES_PER_AGENT=6

# ---------- Free location services (no key) ----------
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
PINCODE_URL=https://api.postalpincode.in
GEO_USER_AGENT=TitleShield-Prototype/1.1 (property title search prototype)

# ---------- Document reading (optional, Gemini free tier) ----------
# Only needed for scanned PDFs and photos. Digital PDFs are read without it.
# Free key: https://aistudio.google.com/apikey  (or paste it on the Settings page)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Web3 escrow (TitleEscrow smart contract) ----------
# embedded: a local Ethereum node starts inside the API (JSON-RPC on CHAIN_PORT); state and keys in data/chain
# rpc:      deploy to any EVM network, e.g. a public testnet: set CHAIN_RPC_URL and two funded keys
# off:      no smart contract
CHAIN_MODE=embedded
CHAIN_PORT=8545
CHAIN_NAME=TitleShield Chain
# CHAIN_RPC_URL=https://...
# CHAIN_TRUSTEE_KEY=0x...
# CHAIN_ORACLE_KEY=0x...
# CHAIN_EXPLORER_URL=https://...
# days after which anyone can refund the buyer if no verdict was reached
ESCROW_DEADLINE_DAYS=45

# The two walkthrough properties in demo/WALKTHROUGH.md replay recorded TinyFish responses
# so the demo is identical every time; every other address calls the live TinyFish API.
DEMO_PROPERTIES=true

# ---------- Orchestration ----------
# inline (no extra services) | temporal
WORKFLOW_ENGINE=inline
TEMPORAL_ADDRESS=localhost:7233
# continuous escrow monitoring cadence
MONITOR_INTERVAL_MINUTES=1440

# ---------- Evidence & trust ----------
# local | s3 (S3 / MinIO with Object Lock)
STORAGE_DRIVER=local
WORM_RETENTION_YEARS=15
TSA_ENABLED=true
TSA_URL=https://freetsa.org/tsr
SIGNER_P12_PASSWORD=titleshield-dev

# ---------- Banking (sandbox) ----------
BANK_WEBHOOK_SECRET=dev-bank-webhook-secret
PLATFORM_FEE_BPS=25
